# Copy to .env for local Node.js or Docker Compose deployment.
# Local production: npm run build, then npm start. Development: npm run dev.
# Docker: docker compose up -d (HOST, PORT and DATA_DIR are fixed in compose.yaml).
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
# Set this to the URL used by browsers and external applications.
# PUBLIC_ORIGIN=http://192.168.0.10:3000
# Use the public HTTPS origin and secure cookies behind an HTTPS reverse proxy.
# PUBLIC_ORIGIN=https://notify.example.com
# COOKIE_SECURE=true
# Optional: base64-encoded 32-byte encryption key. Otherwise generated in the data directory.
# ENCRYPTION_KEY=

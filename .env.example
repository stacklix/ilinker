# Copy to .env for local Node.js or Docker Compose deployment.
# Local production: npm run build, then npm start. Development: npm run dev.
# Docker: docker compose up -d (HOST, PORT and DATA_DIR are fixed in compose.yaml).
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
# Optional: set the URL used by browsers and external applications to enforce a fixed origin.
# PUBLIC_ORIGIN=http://192.168.0.10:3000
# Use the public HTTPS origin and secure cookies behind an HTTPS reverse proxy.
# PUBLIC_ORIGIN=https://notify.example.com
# Set COOKIE_SECURE=true for HTTPS even when PUBLIC_ORIGIN is not set.
# COOKIE_SECURE=true
# Optional: base64-encoded 32-byte encryption key. Otherwise generated in the data directory.
# ENCRYPTION_KEY=
# Optional initial Hako QR login settings; can also be configured in System Settings.
# Encrypted page settings take precedence over these environment variables.
# HAKO_URL=https://hako.example.com
# HAKO_CLIENT_ID=<application ID generated by Hako>
# HAKO_CLIENT_SECRET=<SK generated by Hako>

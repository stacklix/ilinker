# Copy to .env.docker and use: docker compose --env-file .env.docker up -d --build
# Host-side binding; the application always listens on 0.0.0.0 inside the container.
DOCKER_BIND=0.0.0.0
DOCKER_PORT=3000
# Set this to the URL used by browsers and external applications.
# PUBLIC_ORIGIN=http://192.168.0.10:3000
# COOKIE_SECURE=true
# Optional; otherwise encryption.key is generated in the persistent data volume.
# ENCRYPTION_KEY=
